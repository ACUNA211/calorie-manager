# Copy this file to .env.local (never commit real values) and fill in from
# Supabase: Project Settings > API. The publishable key is safe to ship in the
# browser; never put a secret or service-role key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Web Push (ticket 54). The PUBLIC VAPID key only; it is safe in the browser. Create the pair once:
#   npx web-push generate-vapid-keys
# Put the public key here (in web/.env.local or the host's build variables). The private key goes
# only to the server: supabase secrets set VAPID_PRIVATE_KEY=... VAPID_PUBLIC_KEY=... VAPID_SUBJECT=mailto:you@example.com
VITE_VAPID_PUBLIC_KEY=your_vapid_public_key_here
